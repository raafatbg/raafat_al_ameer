<Page x:Class="al_ameer.Features.Customers.CustomerLedgerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Customer Accounts" Background="#0F0F0F">
    <Page.Resources>
        <Style x:Key="LedgerCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="LedgerGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1A1A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#202020"/><Setter Property="AlternatingRowBackground" Value="#282828"/>
            <Setter Property="BorderBrush" Value="#363636"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#363636"/>
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowStyle">
                <Setter.Value><Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#343127"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#4A3E10"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style></Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value><Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121212"/><Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C5000"/><Setter Property="Padding" Value="9,5"/>
            <Setter Property="CaretBrush" Value="#FFD700"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#FFD700"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C5000"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#4A3E10"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4A3E10"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C5000"/>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C5000"/>
        </Style>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Customer debit &amp; credit" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Invoices are debits; recorded payments are credits. Amounts are in LBP."
                           Foreground="#B9B9B9" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Width="100" Height="38" Click="Refresh_Click"
                    Foreground="#FFD700" Background="#222222" BorderBrush="#685700" Cursor="Hand"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="CUSTOMERS" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid DockPanel.Dock="Top" Height="36" Margin="0,0,0,10">
                    <TextBox x:Name="txtCustomerSearch" ToolTip="Search customers by name or phone"
                             TextChanged="CustomerSearch_Changed"/>
                    <TextBlock Text="Search name or phone..." Foreground="#AEB0B4" VerticalAlignment="Center"
                               Margin="10,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtCustomerSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <DataGrid x:Name="dgCustomers" Style="{StaticResource LedgerGrid}" SelectionChanged="CustomerSelection_Changed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer" Binding="{Binding FullName}" Width="*" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat={}{0:N0}}" Width="105" ElementStyle="{StaticResource LedgerCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="txtSelectedCustomer" Text="Select a customer" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtBalance" Text="Outstanding: 0 LBP" Foreground="#FFD700" Margin="0,5,0,0"/>
                </StackPanel>
                <DataGrid x:Name="dgInvoices" Grid.Row="1" Style="{StaticResource LedgerGrid}" SelectionChanged="InvoiceSelection_Changed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat={}{0:dd/MM/yyyy}}" Width="105" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Debit" Binding="{Binding GrandTotal, StringFormat={}{0:N0}}" Width="100" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="100" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Due" Binding="{Binding RemainingBalance, StringFormat={}{0:N0}}" Width="100" ElementStyle="{StaticResource LedgerCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Text="PAYMENT HISTORY" Foreground="#FFD700" FontWeight="Bold" Margin="0,16,0,8"/>
                <DataGrid x:Name="dgPayments" Grid.Row="3" Style="{StaticResource LedgerGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat={}{0:dd/MM/yyyy}}" Width="105" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Invoice ID" Binding="{Binding SaleId}" Width="95" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Credit" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="100" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="100" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Reversed" Binding="{Binding ReversedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="95" ElementStyle="{StaticResource LedgerCell}"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ReversalReason}" Width="140" ElementStyle="{StaticResource LedgerCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock x:Name="txtInvoiceSelection" Text="Select an invoice with an outstanding balance to record a payment."
                               Foreground="#B9B9B9" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="125"/><ColumnDefinition Width="118"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,8,0" Height="36">
                        <TextBox x:Name="txtPaymentAmount" ToolTip="Payment amount in LBP"/>
                        <TextBlock Text="Amount LBP" Foreground="#AEB0B4" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtPaymentAmount}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Column="1" Margin="0,0,8,0" Height="36">
                        <TextBox x:Name="txtPaymentNotes" MaxLength="400" ToolTip="Payment notes (optional)"/>
                        <TextBlock Text="Notes (optional)" Foreground="#AEB0B4" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtPaymentNotes}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="cbMethod" Grid.Column="2" Height="36" Margin="0,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/><ComboBoxItem Content="Bank transfer"/>
                    </ComboBox>
                    <DatePicker x:Name="dpPaymentDate" Grid.Column="3" Height="36" Margin="0,0,8,0"/>
                    <Button x:Name="btnRecordPayment" Grid.Column="4" Content="Record payment" Click="RecordPayment_Click" Foreground="Black"
                            Background="#FFD700" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="5" Content="Reverse" Click="ReversePayment_Click" Margin="8,0,0,0"
                            Foreground="White" Background="#593333" BorderThickness="0" Cursor="Hand"/>
                </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
