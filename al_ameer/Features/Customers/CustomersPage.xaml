<Page x:Class="al_ameer.Features.Customers.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:al_ameer.Features.Customers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CustomersPage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="CUSTOMER DIRECTORY" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="Manage Al Ameer Clients" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="txtSearch" Width="300" Height="45" Margin="0,0,15,0"
                         Background="#1A1A1E" Foreground="White" BorderBrush="#2A2A2F"
                         VerticalContentAlignment="Center" Padding="15,0" 
                         TextChanged="txtSearch_TextChanged" Tag="Search by name or phone..."/>

                <Button Content="+ NEW CUSTOMER" Width="180" Height="45" 
                        Background="#FFD700" Foreground="Black" FontWeight="Bold" Click="AddCustomer_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#1A1A1E" CornerRadius="15" Padding="10">
            <DataGrid x:Name="dgCustomers" AutoGenerateColumns="False" Background="Transparent" 
                      BorderThickness="0" GridLinesVisibility="None" RowHeight="60" 
                      HeadersVisibility="Column" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="200"/>
                    <DataGridTextColumn Header="REG. DATE" Binding="{Binding RegistrationDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="150"/>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Edit" Foreground="#FFD700" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
