<Window x:Class="al_ameer.Features.Inventory.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Product" Height="580" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#1A1B1E" 
        AllowsTransparency="True" WindowStyle="None"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="ModernComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1B1E"/>
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1B1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD700"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="15" Background="#1A1B1E">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="EDIT PRODUCT" Foreground="#FFD700" FontSize="20" FontWeight="Bold"/>
                <Separator Background="#20FFFFFF" Margin="0,10,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Product Name" Foreground="#80FFFFFF" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="Barcode" Foreground="#80FFFFFF" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBarcode" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="Category" Foreground="#80FFFFFF" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbCategory" Style="{StaticResource ModernComboStyle}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price (LBP)" Foreground="#FFD700" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtPrice" Style="{StaticResource ModernInputStyle}" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock Quantity" Foreground="#80FFFFFF" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtStock" Style="{StaticResource ModernInputStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tire Specs (Width / Ratio / Diameter)" Foreground="#80FFFFFF" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtWidth" Grid.Column="0" Style="{StaticResource ModernInputStyle}"/>
                        <TextBox x:Name="txtRatio" Grid.Column="2" Style="{StaticResource ModernInputStyle}"/>
                        <TextBox x:Name="txtDiameter" Grid.Column="4" Style="{StaticResource ModernInputStyle}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Width="100" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                <Button Content="Save Changes" Click="Save_Click" Width="140" Height="40" Style="{StaticResource ModernButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>