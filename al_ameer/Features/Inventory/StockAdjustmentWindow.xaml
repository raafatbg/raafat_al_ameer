<Window x:Class="al_ameer.Features.Inventory.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust stock" Width="520" Height="470" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#171719" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#242428"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#242428"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Adjust inventory" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Every addition or removal is saved with a reason." Foreground="#B9B9BD" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="PRODUCT" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ComboBox x:Name="cbProduct" Height="42" DisplayMemberPath="DisplayName"
                      Background="#242428" Foreground="White" BorderBrush="#555043"
                      IsTextSearchEnabled="True" SelectionChanged="Product_Changed"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="ADJUSTMENT" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbAdd" Content="Add to stock" IsChecked="True" Foreground="White" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="rbSubtract" Content="Remove from stock" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="txtCurrentStock" Text="Select a product" Foreground="#B9B9BD" Margin="0,9,0,0"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="QUANTITY" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBox x:Name="txtQuantity" Height="42" VerticalContentAlignment="Center" ToolTip="Whole units greater than zero"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="REASON" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBox x:Name="txtReason" Height="42" VerticalContentAlignment="Center" ToolTip="For example: delivery, damage, stock count correction"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="4" Text="Example reasons: new delivery, damaged item, stock-count correction."
                   Foreground="#B9B9BD" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="95" Height="38" Margin="0,0,10,0" Click="Cancel_Click"
                    Background="#242428" Foreground="White" BorderBrush="#555043" Cursor="Hand"/>
            <Button Content="Save adjustment" Width="150" Height="38" Click="Save_Click"
                    Background="#FFD700" Foreground="Black" BorderBrush="#FFD700" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
