<Page x:Class="al_ameer.Features.Inventory.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inventory" Background="#0F0F0F">
    <Page.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/><Setter Property="Foreground" Value="#171717"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="#FFE34D"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1C"/><Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#9B8000"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="#303027"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="44" MaxWidth="520" HorizontalAlignment="Left" Background="#202020"
                    BorderBrush="#685700" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock Text="Search categories or products..." Foreground="#AEB0B4" Margin="14,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Foreground="White"
                             CaretBrush="#FFD700" Margin="14,0" VerticalContentAlignment="Center"
                             TextChanged="txtSearch_TextChanged"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="+ ADD PRODUCT" Style="{StaticResource PrimaryButton}"
                    Width="150" Height="44" Margin="16,0,0,0" Click="AddProduct_Click"/>
            <Button Grid.Column="2" Content="+ ADD CATEGORY" Style="{StaticResource SecondaryButton}"
                    Width="150" Height="44" Margin="12,0,0,0" Click="AddCategory_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel x:Name="rootHeading">
                <TextBlock Text="Inventory categories" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="Open a folder to view its products." Foreground="#AEB0B4" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel x:Name="categoryHeading" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                <Button Content="← All categories" Style="{StaticResource SecondaryButton}" Width="145" Height="36"
                        Margin="0,0,16,0" Click="BackToCategories_Click"/>
                <TextBlock x:Name="txtCategoryTitle" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtProductCount" Foreground="#AEB0B4" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border x:Name="folderView" Grid.Row="2" Background="#171717" BorderBrush="#353535"
                BorderThickness="1" CornerRadius="10" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="categoryFolders">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Tag="{Binding CategoryId}" Click="OpenCategory_Click" Cursor="Hand"
                                Width="252" Height="156" Margin="0,0,16,16" Background="Transparent" BorderThickness="0">
                            <Button.Template><ControlTemplate TargetType="Button">
                                <Border x:Name="Folder" Background="#242424" BorderBrush="#5E5100" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Folder" Property="Background" Value="#303027"/>
                                    <Setter TargetName="Folder" Property="BorderBrush" Value="#FFD700"/>
                                </Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Button.Template>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="▰" Foreground="#FFD700" FontSize="34" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CategoryName}" Foreground="White" FontWeight="SemiBold" FontSize="17"
                                           TextTrimming="CharacterEllipsis" Width="210"/>
                                <TextBlock Text="{Binding ProductSummary}" Foreground="#B9B9B9" Margin="0,7,0,0" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border x:Name="productView" Grid.Row="2" Visibility="Collapsed" Background="#1A1A1A"
                BorderBrush="#353535" BorderThickness="1" CornerRadius="10">
            <Grid>
                <DataGrid x:Name="dgInventory" Background="#1A1A1A" BorderThickness="0" Foreground="White"
                          RowBackground="#1E1E1E" AlternatingRowBackground="#252525" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#353535"
                          RowHeight="48" ColumnHeaderHeight="42" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#121212"/><Setter Property="Foreground" Value="#FFD700"/>
                            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#685700"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#343023"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#514617"/></Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10"/><Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="125" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" MinWidth="190" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.CompanyName}" Width="125" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="65" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat={}{0:N0} LBP}" Width="135">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFD700"/><Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Tire Specs" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Text><MultiBinding StringFormat="{}{0}/{1} R{2}">
                                    <Binding Path="TireWidth"/><Binding Path="TireRatio"/><Binding Path="TireDiameter"/>
                                </MultiBinding></TextBlock.Text>
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsTire}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Edit" Foreground="#FFD700" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0" Click="EditProduct_Click"/>
                                <Button Content="Delete" Foreground="#FF7373" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0" Click="DeleteProduct_Click"/>
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="emptyCategoryMessage" Text="No products in this category yet. Use + Add Product to add one."
                           Foreground="#B9B9B9" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>
