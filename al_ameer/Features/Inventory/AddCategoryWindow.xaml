<Window x:Class="al_ameer.Features.Inventory.AddCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Category" Height="390" Width="430" WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None" MouseDown="Window_MouseDown">
    <Border Background="#1A1B1E" BorderBrush="#33FFD700" BorderThickness="1" CornerRadius="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="NEW CATEGORY" Foreground="#FFD700" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Create inventory folder" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,22"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Category name" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                <TextBox x:Name="txtName" Style="{StaticResource ModernInputStyle}" MaxLength="50"/>
                <TextBlock Text="Description (optional)" Foreground="#9CA3AF" Margin="0,18,0,6"/>
                <TextBox x:Name="txtDescription" Height="78" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="#10FFFFFF" Foreground="White" BorderBrush="#20FFFFFF"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" Width="90" Height="40" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Click="Cancel_Click"/>
                <Button Content="Add Category" Width="130" Height="40" Margin="8,0,0,0" Style="{StaticResource ModernButtonStyle}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
