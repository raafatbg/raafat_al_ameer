<Page x:Class="al_ameer.Features.Suppliers.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Suppliers" Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="VENDORS" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Supplier Management" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="txtSearch" Width="300" Height="45" Margin="0,0,15,0" 
                         Background="#1A1A1E" Foreground="White" BorderBrush="#2A2A2F" 
                         VerticalContentAlignment="Center" Padding="15,0" 
                         TextChanged="txtSearch_TextChanged" Tag="Search suppliers..."/>

                <Button Content="+ ADD SUPPLIER" Width="180" Height="45" 
                        Background="#FFD700" Foreground="Black" FontWeight="Bold" 
                        Click="AddSupplier_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#1A1A1E" CornerRadius="15" Padding="10">
            <DataGrid x:Name="dgSuppliers" AutoGenerateColumns="False" Background="Transparent" 
                      BorderThickness="0" GridLinesVisibility="None" RowHeight="60" 
                      HeadersVisibility="Column" CanUserAddRows="False" Foreground="White">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Padding" Value="10,0,0,10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="COMPANY NAME" Binding="{Binding CompanyName}" Width="*"/>
                    <DataGridTextColumn Header="CONTACT PERSON" Binding="{Binding ContactName}" Width="200"/>
                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="200"/>

                    <DataGridTemplateColumn Header="ACTIONS" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Details" Foreground="#FFD700" Background="Transparent" 
                                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>

                                    <Button Content="Delete" Foreground="#EF4444" Background="Transparent" 
                                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                                            Click="DeleteSupplier_Click" Tag="{Binding SupplierID}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>