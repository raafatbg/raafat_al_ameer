<Window x:Class="al_ameer.Features.Employees.EmployeeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee" Width="450" Height="545" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" MouseDown="Window_MouseDown">
    <Border Background="#1A1A1E" BorderBrush="#5C5000" BorderThickness="1" CornerRadius="15" Padding="28">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="txtTitle" Text="ADD EMPLOYEE" Foreground="#FFD700" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,22"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Full name" Foreground="#B9B9B9"/>
                <TextBox x:Name="txtName" Style="{StaticResource ModernInputStyle}" MaxLength="100" Margin="0,5,0,14"/>
                <TextBlock Text="Phone" Foreground="#B9B9B9"/>
                <TextBox x:Name="txtPhone" Style="{StaticResource ModernInputStyle}" MaxLength="40" Margin="0,5,0,14"/>
                <TextBlock Text="Job title" Foreground="#B9B9B9"/>
                <TextBox x:Name="txtJobTitle" Style="{StaticResource ModernInputStyle}" MaxLength="100" Margin="0,5,0,14"/>
                <TextBlock Text="Hire date" Foreground="#B9B9B9"/>
                <DatePicker x:Name="dpHireDate" Height="36" Margin="0,5,0,14"/>
                <TextBlock Text="Monthly salary (LBP)" Foreground="#B9B9B9"/>
                <TextBox x:Name="txtMonthlySalary" Style="{StaticResource ModernInputStyle}" Text="0" Margin="0,5,0,12"/>
                <CheckBox x:Name="chkActive" Content="Active employee" Foreground="White" IsChecked="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Width="90" Height="40" Foreground="White" Background="Transparent" BorderThickness="0" Click="Cancel_Click"/>
                <Button Content="Save Employee" Width="135" Height="40" Style="{StaticResource ModernButtonStyle}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
