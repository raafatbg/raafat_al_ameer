<Page x:Class="al_ameer.Features.Employees.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Employees" Background="#0F0F0F">
    <Page.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1A1A"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#202020"/><Setter Property="AlternatingRowBackground" Value="#282828"/>
            <Setter Property="BorderBrush" Value="#363636"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#363636"/><Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="40"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121212"/><Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C5000"/><Setter Property="Padding" Value="9,5"/>
            <Setter Property="CaretBrush" Value="#FFD700"/>
        </Style>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Employees &amp; salary ledger" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Salary payments appear in Expenses automatically; due entries track what is owed."
                           Foreground="#B9B9B9" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add employee" Width="140" Height="40" Click="AddEmployee_Click"
                    Foreground="Black" Background="#FFD700" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBox x:Name="txtSearch" DockPanel.Dock="Top" Height="36" Margin="0,0,0,10"
                         ToolTip="Search employees" TextChanged="Search_Changed"/>
                <DataGrid x:Name="dgEmployees" Style="{StaticResource DarkGrid}" SelectionChanged="EmployeeSelection_Changed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee" Binding="{Binding FullName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Salary due" Binding="{Binding SalaryBalance, StringFormat={}{0:N0}}" Width="110" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="txtEmployeeName" Text="Select an employee" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtEmployeeDetails" Foreground="#B9B9B9" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtSalaryBalance" Text="Salary due: 0 LBP" Foreground="#FFD700" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Edit employee" Width="115" Height="36" Click="EditEmployee_Click"
                            Foreground="#FFD700" Background="#222222" BorderBrush="#685700" Cursor="Hand"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="SALARY HISTORY" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,0,8"/>
                <DataGrid x:Name="dgEntries" Grid.Row="2" Style="{StaticResource DarkGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat={}{0:dd/MM/yyyy}}" Width="105" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Amount (LBP)" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="130" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Reversed" Binding="{Binding ReversedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="95" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ReversalReason}" Width="140" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="118"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbEntryType" Grid.Column="0" Height="36" Margin="0,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="Due"/><ComboBoxItem Content="Payment"/>
                    </ComboBox>
                    <TextBox x:Name="txtAmount" Grid.Column="1" Height="36" Margin="0,0,8,0" ToolTip="Amount in LBP"/>
                    <TextBox x:Name="txtNotes" Grid.Column="2" Height="36" Margin="0,0,8,0" MaxLength="400" ToolTip="Notes or salary period"/>
                    <DatePicker x:Name="dpEntryDate" Grid.Column="3" Height="36" Margin="0,0,8,0"/>
                    <Button Grid.Column="4" Content="Post entry" Click="PostEntry_Click" Foreground="Black"
                            Background="#FFD700" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="5" Content="Reverse" Click="ReverseEntry_Click" Margin="8,0,0,0"
                            Foreground="White" Background="#593333" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
