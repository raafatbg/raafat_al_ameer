<Page x:Class="al_ameer.Features.Reports.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Financial Reports" Background="Transparent">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,40">
            <StackPanel>
                <TextBlock Text="AL AMEER ANALYTICS" Foreground="#FFD700" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Financial Overview" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,0,0">
                <TextBlock Text="Filter Month:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
                <DatePicker x:Name="dpFilter" Width="180" Height="45" VerticalContentAlignment="Center" 
                            SelectedDateChanged="DateChanged" FontSize="16"/>

                <Button Content="PRINT FULL REPORT" Width="220" Height="50" Margin="20,0,0,0"
                        Background="#FFD700" Foreground="Black" FontWeight="Bold" FontSize="14" Click="PrintReport_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,14">
            <Border Background="#1A1A1E" CornerRadius="20" Margin="0,0,15,0" Padding="30">
                <StackPanel>
                    <TextBlock Text="TOTAL SALES" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalRevenue" Text="0 LBP" Foreground="White" FontSize="38" FontWeight="Bold" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1A1E" CornerRadius="20" Margin="7,0,7,0" Padding="30">
                <StackPanel>
                    <TextBlock Text="TOTAL EXPENSES" Foreground="#9CA3AF" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalExpenses" Text="0 LBP" Foreground="#EF4444" FontSize="38" FontWeight="Bold" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1A1E" CornerRadius="20" Margin="15,0,0,0" Padding="30" BorderBrush="#FFD700" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="NET PROFIT" Foreground="#FFD700" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="lblNetProfit" Text="0 LBP" Foreground="White" FontSize="38" FontWeight="Bold" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#1A1A1E" CornerRadius="20" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="DAILY PERFORMANCE LOG" Foreground="#9CA3AF" FontWeight="Bold" Margin="10,0,0,20"/>

                <DataGrid Grid.Row="1" x:Name="dgProfitReport" Background="Transparent" BorderThickness="0" 
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="70" 
                          AutoGenerateColumns="False" FontSize="18" Foreground="White" 
                          IsReadOnly="True" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding ReportDate, StringFormat=\{0:dd MMMM yyyy\}}" Width="2*"/>
                        <DataGridTextColumn Header="SALES" Binding="{Binding DailySales, StringFormat={}{0:N0} LBP}" Width="*"/>
                        <DataGridTextColumn Header="EXPENSES" Binding="{Binding DailyExpenses, StringFormat={}{0:N0} LBP}" Width="*"/>
                        <DataGridTextColumn Header="NET PROFIT" Binding="{Binding NetDaily, StringFormat={}{0:N0} LBP}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#FFD700"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>