<Page x:Class="al_ameer.Features.Reports.FinancialReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports" Background="#0F0F0F">
    <Page.Resources>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#202020"/>
            <Setter Property="AlternatingRowBackground" Value="#282828"/><Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="RowHeight" Value="38"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121212"/><Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Financial reports" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,18">
            <TextBlock Text="From" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="dpFrom" Width="130"/>
            <TextBlock Text="Through" Foreground="White" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <DatePicker x:Name="dpThrough" Width="130"/>
            <Button Content="Refresh" Width="100" Margin="16,0,0,0" Background="#FFD700" Foreground="Black" Click="Refresh_Click"/>
        </StackPanel>
        <TabControl Grid.Row="2" Background="#1A1A1A" Foreground="White" BorderBrush="#685700">
            <TabItem Header="Cash flow">
                <DockPanel Margin="12">
                    <TextBlock x:Name="txtCashSummary" DockPanel.Dock="Top" Foreground="#FFD700" FontSize="17" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="Operating cash flow: sale receipts minus expenses and salary payments. Purchases are not included." Foreground="#B9B9B9" Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgCash" Style="{StaticResource GridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                            <DataGridTextColumn Header="Receipts LBP" Binding="{Binding Inflow, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="Expenses LBP" Binding="{Binding Expenses, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="Salary paid LBP" Binding="{Binding SalaryPayments, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="Net LBP" Binding="{Binding Net, StringFormat={}{0:N0}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Customer aging">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="Aging uses invoice date; no contractual due date is stored. Balances shown as of today." Foreground="#B9B9B9" Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgAging" Style="{StaticResource GridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="2*"/>
                            <DataGridTextColumn Header="0–30 days" Binding="{Binding Current, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="31–60 days" Binding="{Binding Days31To60, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="61–90 days" Binding="{Binding Days61To90, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="90+ days" Binding="{Binding Over90, StringFormat={}{0:N0}}" Width="*"/>
                            <DataGridTextColumn Header="Total LBP" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Salary balances">
                <DataGrid x:Name="dgSalary" Margin="12" Style="{StaticResource GridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="2*"/>
                        <DataGridTextColumn Header="Salary due LBP" Binding="{Binding Due, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Paid LBP" Binding="{Binding Paid, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Balance LBP" Binding="{Binding Balance, StringFormat={}{0:N0}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
