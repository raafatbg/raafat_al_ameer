<Page x:Class="al_ameer.Features.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Background="#0F0F0F"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#20FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,0,0,30">
            <TextBlock Text="OVERVIEW" Foreground="#FFD700" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Business Dashboard" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="2" Rows="2">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL SALES" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtTotalSales" Text="0 LBP" Foreground="#FFD700" FontSize="36" FontWeight="Bold" Margin="0,10"/>
                        <TextBlock Text="Today's Revenue" Foreground="#40FFD700" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="ITEMS IN STOCK" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtTotalItems" Text="0" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10"/>
                        <TextBlock Text="Total Quantity Available" Foreground="#40FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="STOCK VALUE" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtStockValue" Text="0 LBP" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10"/>
                        <TextBlock Text="Capital at Cost" Foreground="#40FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" BorderBrush="#50FF4C4C">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="LOW STOCK ALERT" Foreground="#FF4C4C" FontSize="14" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtLowStock" Text="0" Foreground="#FF4C4C" FontSize="36" FontWeight="Bold" Margin="0,10"/>
                        <TextBlock Text="Products below 5 units" Foreground="#40FF4C4C" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Column="1" Margin="20,10,0,0">
                <TextBlock Text="QUICK ACTIONS" Foreground="#80FFFFFF" FontSize="12" FontWeight="Bold" Margin="10,0,0,20"/>

                <Button Content="+ NEW SALE (POS)" Style="{StaticResource ActionBtn}" Click="NewSale_Click"/>

                <Button Content=" REFRESH DATA" Click="Refresh_Click" Background="#25252A" 
                        Foreground="#FFD700" Style="{StaticResource ActionBtn}" />

                <Separator Background="#20FFFFFF" Margin="0,10,0,20"/>

                <Button Content="INVENTORY" Style="{StaticResource ActionBtn}" Background="Transparent" 
                        Foreground="White" BorderBrush="#FFD700" BorderThickness="1" Click="ViewInventory_Click"/>

                <Button Content="+ / −  ADJUST STOCK" Style="{StaticResource ActionBtn}" Background="#25252A"
                        Foreground="#FFD700" Click="AdjustStock_Click" ToolTip="Add or remove stock with a required reason"/>

                <Button Content="FINANCIAL REPORTS" Style="{StaticResource ActionBtn}" Background="Transparent" 
                        Foreground="#FFD700" BorderBrush="#50FFD700" BorderThickness="1" Click="ViewReports_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
