<Page x:Class="al_ameer.Features.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Height="150" Margin="0,0,0,30">
            <Border Background="#10FFFFFF" CornerRadius="20" Margin="0,0,15,0" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Total Sales" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalSales" Text="0 LBP" Foreground="#FFD700" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Text="Today" Foreground="#40FFD700" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#10FFFFFF" CornerRadius="20" Margin="15,0" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Inventory Items" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalItems" Text="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Text="In Stock" Foreground="#50FFFFFF" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#10FFFFFF" CornerRadius="20" Margin="15,0" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Stock Value" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtStockValue" Text="0 LBP" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Text="Investment" Foreground="#50FFFFFF" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#10FF6B6B" CornerRadius="20" Margin="15,0,0,0" BorderBrush="#20FF6B6B" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Low Stock" Foreground="#FF6B6B" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtLowStock" Text="0" Foreground="#FF6B6B" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Text="Items to Reorder" Foreground="#50FF6B6B" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#05FFFFFF" CornerRadius="25" BorderBrush="#10FFFFFF" BorderThickness="1" Margin="0,0,15,0">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Recent Transactions" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <DataGrid Grid.Row="1" x:Name="dgRecentSales" Background="Transparent" BorderThickness="0" Foreground="White" 
                              RowBackground="Transparent" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:N0} LBP}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Quick Actions" Foreground="#80FFFFFF" FontSize="14" Margin="10,0,0,15"/>
                <Button Content="New Sale" Height="50" Margin="0,0,0,10" Style="{StaticResource ModernButtonStyle}"/>
                <Button Content="Register Customer" Height="50" Margin="0,0,0,10" Background="#20FFFFFF" Foreground="White" Style="{StaticResource ModernButtonStyle}"/>
                <Button Content="View Reports" Height="50" Background="Transparent" BorderBrush="#20FFFFFF" BorderThickness="1" Foreground="White" Style="{StaticResource ModernButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>