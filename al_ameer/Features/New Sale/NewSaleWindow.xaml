<Window x:Class="al_ameer.Features.Sales.NewSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Al Ameer POS" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen" Background="#0F0F12"
        WindowStyle="None" AllowsTransparency="True" MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGold" Color="#FFD700"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#1A1A1E"/>
        <SolidColorBrush x:Key="SurfaceDark" Color="#121215"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDim" Color="#9CA3AF"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25252A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckoutButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGold}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Padding" Value="10,15"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2A2A2F"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="Sales" Foreground="{StaticResource TextDim}" FontSize="14"/>
                <TextBlock Text=" / " Foreground="{StaticResource TextDim}" FontSize="14" Margin="8,0"/>
                <TextBlock Text="New Transaction" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceCard}" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSearch" Height="50" FontSize="18" VerticalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="White" 
                             KeyDown="txtSearch_KeyDown" Tag="Search tires or scan..."/>
                    <Button Grid.Column="1" Content="" FontFamily="Segoe MDL2 Assets" 
                            Style="{StaticResource IconButton}" FontSize="20" Click="FocusBarcode_Click" Width="50"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource SurfaceCard}" CornerRadius="16" Padding="15">
                <DataGrid x:Name="dgCart" Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          RowHeight="72" HeadersVisibility="Column" AutoGenerateColumns="False" 
                          CanUserAddRows="False" ColumnHeaderStyle="{StaticResource DarkColumnHeader}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#25252A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM DETAILS" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding SellingPrice, StringFormat={}{0:N0} LBP}" Width="150"/>
                        <DataGridTemplateColumn Header="QTY" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-" Width="28" Height="28" Click="QtyMinus_Click" Style="{StaticResource IconButton}"/>
                                            <TextBlock Text="{Binding CartQuantity}" Foreground="White" Width="35" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <Button Content="+" Width="28" Height="28" Click="QtyPlus_Click" Style="{StaticResource IconButton}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding LineTotal, StringFormat={}{0:N0} LBP}" Width="150" FontWeight="Bold"/>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="16"
                                            Click="RemoveItem_Click" Style="{StaticResource IconButton}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource SurfaceCard}" CornerRadius="20" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CUSTOMER" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="20" MouseDown="AddCustomer_Click" Cursor="Hand">
                        <StackPanel>
                            <TextBlock x:Name="lblCustomerName" Text="Walk-in Customer" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="No active discount" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL AMOUNT" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotal" Text="0 LBP" Foreground="White" FontSize="56" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock x:Name="lblTotalUSD" Text="$0.00 USD" Foreground="{StaticResource AccentGold}" FontSize="20" HorizontalAlignment="Center" Opacity="0.9"/>

                    <Separator Background="#2A2A2F" Margin="0,40" Height="1"/>

                    <Grid>
                        <TextBlock Text="Total Items" Foreground="{StaticResource TextDim}" FontSize="14"/>
                        <TextBlock x:Name="lblTotalItems" Text="0" Foreground="White" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Button Content=" Print" Click="Print_Click" Height="48" Margin="0,0,8,0" Background="#25252A" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="💾 Draft" Click="SaveDraft_Click" Height="48" Margin="8,0,0,0" Background="#25252A" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </UniformGrid>

                    <Button x:Name="btnComplete" Content="Finish Transaction" Style="{StaticResource CheckoutButton}" Height="70" Click="CompleteSale_Click"/>

                    <Button Content="Dismiss" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Margin="0,15,0,0" Click="Cancel_Click" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>