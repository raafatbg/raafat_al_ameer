<Page x:Class="al_ameer.Features.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings" Background="#0F0F0F">
    <StackPanel Margin="32" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Settings / الإعدادات" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Language / اللغة" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,30,0,8"/>
        <ComboBox x:Name="cbLanguage" Height="40" SelectedIndex="0">
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="العربية" Tag="ar"/>
        </ComboBox>
        <TextBlock Text="LBP per 1 USD / ليرة لبنانية لكل دولار" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,26,0,8"/>
        <TextBox x:Name="txtRate" Height="40" Padding="10,6" Background="#222222" Foreground="White" BorderBrush="#685700"/>
        <TextBlock Text="Applies to new sales and price conversions; existing invoices are unchanged. / ينطبق على المبيعات والتحويلات الجديدة فقط." TextWrapping="Wrap" Foreground="#B9B9B9" Margin="0,10,0,0"/>
        <Button Content="Save / حفظ" Width="130" Height="40" HorizontalAlignment="Left" Margin="0,28,0,0" Background="#FFD700" Foreground="Black" FontWeight="Bold" Click="Save_Click"/>
    </StackPanel>
</Page>
