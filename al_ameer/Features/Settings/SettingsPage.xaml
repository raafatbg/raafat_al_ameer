<Page x:Class="al_ameer.Features.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings" Background="Transparent">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,40">
            <StackPanel>
                <TextBlock Text="CONFIGURATION" Foreground="#FFD700" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="System Settings" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>

            <Button x:Name="btnLang" Content="Arabic / عربي" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="160" Height="45" Background="#25252A" Foreground="White" 
                    BorderBrush="#FFD700" BorderThickness="1" Click="ChangeLanguage_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">
                <Border Background="#1A1A1E" Width="500" CornerRadius="20" Padding="30" Margin="0,0,20,20">
                    <StackPanel>
                        <TextBlock Text="BUSINESS PROFILE" Foreground="#9CA3AF" FontSize="13" FontWeight="Bold" Margin="0,0,0,25"/>
                        <TextBlock Text="Shop Name" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtShopName" Text="Al Ameer Tires" Height="45" Background="#121215" Foreground="White" BorderBrush="#2A2A2F" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Phone Number" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtShopPhone" Text="+961 70 000 000" Height="45" Background="#121215" Foreground="White" BorderBrush="#2A2A2F" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1E" Width="400" CornerRadius="20" Padding="30" Margin="0,0,20,20" BorderBrush="#FFD700" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="FINANCIALS" Foreground="#FFD700" FontSize="13" FontWeight="Bold" Margin="0,0,0,25"/>
                        <TextBlock Text="USD Exchange Rate (LBP)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtExchangeRate" Text="90000" Height="60" FontSize="24" FontWeight="Bold" Background="#121215" Foreground="White" BorderBrush="#FFD700" Padding="15,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Updating this changes all calculations." Foreground="#6B7280" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1E" Width="400" CornerRadius="20" Padding="30" Margin="0,0,20,20">
                    <StackPanel>
                        <TextBlock Text="SYSTEM ACTIONS" Foreground="#9CA3AF" FontSize="13" FontWeight="Bold" Margin="0,0,0,25"/>
                        <Button Content="BACKUP DATABASE" Height="50" Background="#25252A" Foreground="White" BorderThickness="0" Margin="0,0,0,15" Click="Backup_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="SAVE ALL SETTINGS" Height="60" Background="#FFD700" Foreground="Black" FontWeight="Bold" Click="SaveSettings_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>