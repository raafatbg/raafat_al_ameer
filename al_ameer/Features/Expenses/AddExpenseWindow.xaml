<Window x:Class="al_ameer.Features.Expenses.AddExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Expense" Height="550" Width="450"
        WindowStartupLocation="CenterOwner" Background="#0F0F12"
        WindowStyle="None" AllowsTransparency="True" MouseDown="Window_MouseDown">

    <Border BorderBrush="#1A1A1E" BorderThickness="1" CornerRadius="20" Background="#1A1A1E">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="NEW OUTFLOW" Foreground="#FFD700" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Record Expense" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Category (e.g., Rent, Utilities)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,8"/>
                <ComboBox x:Name="cbCategory" Height="45" Background="#121215" Foreground="White" BorderBrush="#2A2A2F">
                    <ComboBoxItem Content="Rent"/>
                    <ComboBoxItem Content="Utilities"/>
                    <ComboBoxItem Content="Salaries"/>
                    <ComboBoxItem Content="Stock Purchase"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Text="Amount (LBP)" Foreground="#9CA3AF" FontSize="12" Margin="0,20,0,8"/>
                <TextBox x:Name="txtAmount" Height="45" Background="#121215" Foreground="White" BorderBrush="#2A2A2F" Padding="10,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Description" Foreground="#9CA3AF" FontSize="12" Margin="0,20,0,8"/>
                <TextBox x:Name="txtDescription" Height="80" Background="#121215" Foreground="White" BorderBrush="#2A2A2F" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button Content="SAVE EXPENSE" Height="55" FontWeight="Bold" Background="#FFD700" Foreground="Black" BorderThickness="0" Click="Save_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cancel" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>