<Page x:Class="al_ameer.Features.Expenses.ExpensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Expenses" 
      Background="#0F0F0F">

    <Page.Resources>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="CardPanelBrush" Color="#1A1A1A"/>

        <Style x:Key="GoldButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <Border Width="450" Height="45" Background="#1A1A1A" CornerRadius="10" 
                    BorderBrush="#33FFD700" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Search by category or description..." Foreground="#50FFFFFF"
                               Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="#FFD700" Margin="15,0"
                             VerticalContentAlignment="Center" TextChanged="txtSearch_TextChanged"/>
                </Grid>
            </Border>
            <Button Content="+ ADD EXPENSE" Style="{StaticResource GoldButtonStyle}"
                    Width="180" Height="45" Margin="25,0" Click="AddExpense_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="15" BorderBrush="#20FFD700" BorderThickness="1">
            <DataGrid x:Name="dgExpenses" Background="Transparent" BorderThickness="0"
                      Foreground="White" RowBackground="Transparent" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#10FFD700" AutoGenerateColumns="False"
                      CanUserAddRows="False" RowHeight="60" ColumnHeaderHeight="45"
                      IsReadOnly="True" SelectionUnit="FullRow">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#121212"/>
                        <Setter Property="Foreground" Value="#FFD700"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#FFD700"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFD700"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#35FFD700"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding ExpenseDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="150"/>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>

                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat={}{0:N0} LBP}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,15,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="ACTIONS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Background="Transparent" Foreground="#FF4C4C" 
                                        BorderThickness="0" Cursor="Hand" Click="DeleteExpense_Click" FontWeight="SemiBold"
                                        Tag="{Binding ExpenseID}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>