<Page x:Class="al_ameer.Features.Services.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Services" Background="#0F0F0F">
    <Page.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121212"/><Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C5000"/><Setter Property="Padding" Value="9,6"/>
        </Style>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Services" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Maintain service names and prices for the Sales browser. Inactive services remain on old invoices."
                       Foreground="#B9B9B9" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="dgServices" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionChanged="ServiceSelection_Changed" SelectionMode="Single" SelectionUnit="FullRow"
                      Background="#1A1A1A" Foreground="White" RowBackground="#202020"
                      AlternatingRowBackground="#282828" BorderBrush="#363636" RowHeight="42">
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="White"/>
                    <Style.Triggers><Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#4A3E10"/><Setter Property="Foreground" Value="White"/>
                    </Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="White"/>
                    <Style.Triggers><Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/>
                    </Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*"/>
                    <DataGridTextColumn Header="Price LBP" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#363636" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock x:Name="txtEditorTitle" Text="Add service" Foreground="#FFD700" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Service name" Foreground="#B9B9B9" Margin="0,20,0,6"/>
                    <TextBox x:Name="txtName" Height="38" MaxLength="150"/>
                    <TextBlock Text="Price (LBP)" Foreground="#B9B9B9" Margin="0,18,0,6"/>
                    <TextBox x:Name="txtPrice" Height="38"/>
                    <TextBlock Text="Description" Foreground="#B9B9B9" Margin="0,18,0,6"/>
                    <TextBox x:Name="txtDescription" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <CheckBox x:Name="chkActive" Content="Available in Sales" Foreground="White" IsChecked="True" Margin="0,18,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Content="New" Width="90" Height="38" Click="New_Click" Background="#222222" Foreground="#FFD700" BorderBrush="#685700"/>
                        <Button Content="Save service" Width="130" Height="38" Margin="8,0,0,0" Click="Save_Click" Background="#FFD700" Foreground="Black" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
